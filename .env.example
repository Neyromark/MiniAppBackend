# Скопируйте в .env (он в .gitignore). Значения — как есть, без кавычек и экранирования.
HOST=127.0.0.1
PORT=8000

# По умолчанию — SQLite-файл miniapp.db. Чтобы работать с MSSQL бота, задайте DB_HOST:
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_NAME=MaxBotDispecherTasks
# DB_USER=sa
# DB_PASSWORD=YourStrong@Password1
# DB_DRIVER=ODBC Driver 17 for SQL Server
# (нужен pyodbc) и для общей базы с ботом:
# SEED_DEMO=false

SEED_DEMO=true

# --- Связь с чат-ботом (WebSocket /ws/bot) ---
# Общий секрет: то же значение BRIDGE_TOKEN должно быть в .env бота. Без него канал открыт только для localhost.
# BRIDGE_TOKEN=придумайте-длинную-случайную-строку
# Адрес этого канала, к которому подключается бот (параметр читает бот, у мини-аппа он только для справки):
MINIAPP_WS_URL=ws://127.0.0.1:8000/ws/bot
# BOT_NOTIFY=true
# WATCH_INTERVAL_SECONDS=10   # запасной опрос БД на случай, если бот недоступен

# --- Авторизация через WebAppData от MAX (https://dev.max.ru/docs/webapps/validation) ---
# ОБЯЗАТЕЛЬНО: токен того же бота, из которого открывается мини-приложение (тот же, что BOT_TOKEN у CurrentChatBot).
# Без него сервер не запустится: подпись данных запуска проверить нечем.
BOT_TOKEN=
# Насколько старыми могут быть данные запуска (auth_date), секунды. 0 — не проверять. По умолчанию сутки.
# AUTH_MAX_AGE_SECONDS=86400
# ТОЛЬКО ДЛЯ РАЗРАБОТКИ: пускать по неподписанному user.id (index.html?dev=1&user=N). В проде — false или удалить.
# DEV_AUTH=false
# DEV_FALLBACK_USER=false   # работает только вместе с DEV_AUTH: неизвестный MaxId → первый администратор
